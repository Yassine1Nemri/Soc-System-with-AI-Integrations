<!-- Local rules -->
<!-- Custom rule IDs must be between 100000 and 120000 -->

<group name="local,sshd,bruteforce,">

  <!-- Rule 1: 5 failed SSH passwords (existing user) from the same IP within 60 seconds -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>Custom: SSH brute force - 5 failed logins from $(srcip) in 60s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Rule 2: 5 attempts with non-existent usernames from the same IP within 60 seconds -->
  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_srcip />
    <description>Custom: SSH brute force - 5 invalid-user attempts from $(srcip) in 60s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- SSH authentication succeeded after five failed login attempts -->

  <rule id="100102" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <if_sid>5715</if_sid>
    <same_srcip />

    <description>
        SSH authentication succeeded after five failed login attempts
        from the same source IP within 60 seconds.
    </description>

    <mitre>
        <id>T1110.001</id>
        <id>T1078</id>
    </mitre>

    <group>authentication_success,brute_force,correlation,</group>
  </rule>

</group>
<group name="local,audit,">
  <rule id="100210" level="8">
    <if_group>audit</if_group>
    <field name="audit.key">tool_transfer</field>
    <description>Audit: curl/wget executed (tool_transfer)</description>
    <mitre><id>T1105</id></mitre>
  </rule>
  <rule id="100211" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">history_change</field>
    <description>Audit: shell history file modified</description>
    <mitre><id>T1070.003</id></mitre>
  </rule>
  <rule id="100212" level="9">
    <if_group>audit</if_group>
    <field name="audit.key">log_change</field>
    <description>Audit: system log file modified</description>
    <mitre><id>T1070.002</id></mitre>
  </rule>
</group>

<group name="local,ufw,">
  <rule id="100220" level="3">
    <decoded_as>kernel</decoded_as>
    <match>UFW BLOCK</match>
    <description>UFW: blocked connection attempt.</description>
    <group>ufw_block,</group>
  </rule>

  <rule id="100221" level="10" frequency="4" timeframe="120">
    <if_matched_sid>100220</if_matched_sid>
    <same_source_ip />
    <description>UFW: possible port scan - multiple blocked connections from the same source.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,</group>
  </rule>
</group>
